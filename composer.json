{
    "name": "laboiteacode/webanalytics-laravel",
    "description": "Pont Laravel du SDK Affluence (laboiteacode/webanalytics-php) : pageviews serveur automatiques (middleware), facade et configuration.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "analytics",
        "laravel",
        "privacy",
        "rgpd",
        "sans-cookies",
        "server-side"
    ],
    "require": {
        "php": ">=8.1",
        "laboiteacode/webanalytics-php": "^1.0@dev",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "LaBoiteACode\\WebAnalytics\\Laravel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaBoiteACode\\WebAnalytics\\Laravel\\WebAnalyticsServiceProvider"
            ],
            "aliases": {
                "WebAnalytics": "LaBoiteACode\\WebAnalytics\\Laravel\\Facades\\WebAnalytics"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "repositories": [
        {
            "type": "path",
            "url": "../php",
            "options": {
                "symlink": true
            }
        }
    ],
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0"
    },
    "autoload-dev": {
        "psr-4": {
            "LaBoiteACode\\WebAnalytics\\Laravel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "prefer-stable": true
}
