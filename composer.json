{
    "name": "quiet-metrics/laravel-metrics",
    "description": "Pont Laravel du SDK Quiet Metrics (quiet-metrics/php-metrics) : pageviews serveur automatiques (middleware), facade et configuration.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://quietmetrics.dev",
    "authors": [
        {
            "name": "Alexandre Ribes (La Boîte à Code)",
            "homepage": "https://laboiteacode.fr"
        }
    ],
    "support": {
        "issues": "https://github.com/Quiet-Metrics/laravel-metrics/issues",
        "source": "https://github.com/Quiet-Metrics/laravel-metrics"
    },
    "keywords": [
        "analytics",
        "laravel",
        "privacy",
        "rgpd",
        "sans-cookies",
        "server-side"
    ],
    "require": {
        "php": ">=8.1",
        "quiet-metrics/php-metrics": "^0.3",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "QuietMetrics\\Laravel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "QuietMetrics\\Laravel\\QuietMetricsServiceProvider"
            ],
            "aliases": {
                "QuietMetrics": "QuietMetrics\\Laravel\\Facades\\QuietMetrics"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "repositories": [
        {
            "type": "path",
            "url": "../php",
            "options": {
                "symlink": true,
                "versions": {
                    "quiet-metrics/php-metrics": "0.3.x-dev"
                }
            }
        }
    ],
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0"
    },
    "autoload-dev": {
        "psr-4": {
            "QuietMetrics\\Laravel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "prefer-stable": true
}
